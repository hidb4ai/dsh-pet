# ── Generated asset intermediates (rebuild with scripts/*.py) ──
step01/
step02/
step03/
step04/

# ── Source videos (hosted in the assets-videos GitHub Release) ──
video/*.mp4

# ── Premiere Pro local masking workspace and intermediates ──
#   pr/      Transparent .mov exports used by pipeline B
#   prproj/  Premiere projects, mask caches and autosaves (about 2 GB)
pr/
prproj/

# ── Machine-local tools ──
.tools/

# ── Python ──
__pycache__/
*.py[cod]
.venv/
.uv-cache/

# ── Node ──
node_modules/
.npm-cache/
.npm-tmp-cache/
npm-debug.log*
*.tgz

# ── Temporary files and backups ──
temp/

# ── Generated dsh-pet build output (run pnpm run build after cloning)──
#   lib/                      tsdown bundles and generated TypeScript declarations
#   runtime/electron-helper/shared-core.js  Shared desktop logic built by scripts/build-desktop-core.mjs
# Declarations are generated by gen-types.mjs and are ignored alongside bundles.
dsh-pet/lib/
dsh-pet/runtime/electron-helper/shared-core.js

# ── Desktop distributions (rebuild with node scripts/dist.mjs)──
dsh-pet/dist-app/

# ── IDEs and editors ──
.idea/
.vscode/
*.swp

# ── Operating system files ──
.DS_Store
Thumbs.db
desktop.ini
