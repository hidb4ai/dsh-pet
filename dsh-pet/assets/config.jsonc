// dsh-pet configuration (JSONC supports line and block comments).
// The browser reads the merged configuration from /dsh-pet-7340/config, without a filename extension.
// Missing structural fields use defaults silently; explicitly invalid values produce warnings.
// Field ownership:
// - Per instance in pets[]: name, id, size, balanceEnabled, whisperEnabled, workStatusEnabled,
//   fixedEnabled, display, position, and an optional whisperPrompt that replaces the entry's persona.
// - Global defaults, overridable by each pet/<name>-config.json entry: physics, font, confineToScreen,
//   whisperImageEnabled, chatImageEnabled, chatAnimationEnabled, chatMemoryRounds, whisperModel,
//   chatModel, and eventsRefreshSec.
// - Per entry (main or a custom pet type): whisperPrompt, memes, workStatusTexts, animations,
//   and animationWeights.
// - Read only from main: notificationsEnabled and eventsRefreshSec.balance.
// Top-level objects are replaced as a whole, not merged recursively. Consumers apply their own
// fallbacks for omitted nested keys (for example, 1,800 seconds for balance and 300 for whispers).
{
  // Persona for whispers and chat (per entry; a custom pet file can override it).
  // When pets[].whisperEnabled is true, the current provider generates a short bubble at the
  // interval in eventsRefreshSec.whisper. A nonempty pets[].whisperPrompt replaces this default;
  // an omitted or empty instance prompt inherits it. The settings page writes the same user-layer field.
  // Write only the persona here. The model's system message also includes the pet's name and current
  // time context (date, weekday, time of day, weekend/working day and holidays). There is no length cap.
  "whisperPrompt": "你是主人桌面上的Q版蓝发小女仆，会时不时碎碎念一句。说话要自然随意、短短一句（20字以内），温柔乖巧带点俏皮，说人话不啰嗦，不要解释你自己，不要提你是AI。",
  // Sleep talk uses this entry's whisperPrompt and runs at eventsRefreshSec.sleepTalk intervals.
  // Sleep-specific instructions live in code. Sleep talk displays a bubble without animation or speech.
  // Sleep refusal lines (per entry): while asleep, requests to speak, chat, check balance, play an
  // animation or show a bubble are refused with a random line below. Use a nonempty string array;
  // missing or invalid arrays fall back to the built-in refusal lines.
  "sleepRefuseTexts": [
    "我在睡觉，别烦我……",
    "唔……让我再睡一会儿。",
    "呼……呼……（装作没听见）"
  ],
  // Sleep/wake lines (per entry). Pick one bubble when the start or end animation runs.
  // Use nonempty string arrays; missing or invalid arrays fall back to these built-in values.
  // The lines are defined here rather than duplicated in code.
  "sleepStartTexts": ["好困……我先睡一会儿。", "那我去睡啦，晚安。"],
  "sleepEndTexts": ["唔……我醒了。", "睡饱啦，主人！"],
  // Recent chat rounds (global default; custom pet entries can override it).
  // One round is one user message and one reply. This limits the history sent with each request;
  // it does not delete stored memory.json history. Use a nonnegative number; the default is 10.
  // Resolution order: pet entry, global setting, built-in default. The model/context settings panel
  // writes this field in the user configuration.
  "chatMemoryRounds": 10,
  // Whisper model (global default, overridable per entry).
  // Leave both provider and model empty to follow the current conversation model. Set both to use
  // a separate, cheaper or faster model for background whispers. Supplying only one is invalid:
  // warn and fall back to the current conversation model. DSH settings use the host's model list.
  "whisperModel": { "provider": "", "model": "" },
  // Chat model (global default, overridable per entry).
  // Leave both fields empty to follow the current conversation model. If the selected model fails
  // (for example, missing credentials or a removed model), retry once with the current conversation
  // model before reporting a generation failure.
  "chatModel": { "provider": "", "model": "" },
  // Whisper images (global default, overridable per entry).
  // Randomly choose one image from memes for each whisper; unlike chat, whispers do not select an
  // image from conversation context. Required boolean; refresh or restart after changing it.
  "whisperImageEnabled": true,
  // Chat images (global default, overridable per entry).
  // Give the model meme names and descriptions so it can choose an image for the current context.
  // No selection or an unknown image produces a text-only reply. Required boolean; refresh or restart.
  "chatImageEnabled": true,
  // Chat animation (global default, overridable per entry).
  // Give the model the actions in animations.categories. A matching action marker in the reply
  // triggers that animation; otherwise show text only. Idle, turn and event animations are excluded.
  // Required boolean; refresh or restart after changing it.
  "chatAnimationEnabled": true,
  // Maximum meme candidates sent with each chat request (global default, overridable per entry).
  // Only the first N entries in configuration order are sent. Move preferred images earlier in memes.
  // The list is repeated in every request, so fewer candidates reduce prompt size. This file's
  // 27 candidates are roughly 1,100 characters (about 650 tokens; model tokenization varies).
  // Use a nonnegative integer: default 20; 0 sends every candidate. This does not affect whispers,
  // which include only the selected image description.
  "chatImageLimit": 20,
  // Speech output (global default, overridable per entry).
  // Read manual whispers (menu/slash command) and chat replies aloud. Disabled by default.
  // Bubbles, memory and notifications are unaffected. The chat speaker button can always request
  // playback of a single reply independently of this setting.
  "voiceEnabled": false,
  // Voice ID from /voice/voices (the supported Chinese voices).
  // An empty or unknown ID produces a warning and falls back to zh-CN-XiaoyiNeural.
  "voiceName": "zh-CN-XiaoyiNeural",
  // Global playback volume: a number from 0 (muted) to 1 (full volume), shared by all speech categories.
  // Changing volume affects playback only and does not trigger another TTS request.
  "voiceVolume": 1,
  // Read periodic whispers aloud (global default, off by default).
  // Whisper bubbles and animations are unaffected.
  "voiceWhisperEnabled": false,
  // Read to-do reminders aloud (global default, off by default).
  "voiceTodoEnabled": false,
  // Read work-state messages aloud (global default, off by default).
  // Use the configured line when a task finishes, fails or waits for approval. Like system
  // notifications, speak only when the page is not focused or visible.
  "voiceNotifyEnabled": false,
  // Meme image map: filename stem -> description used by the model.
  // Each key must match assets/memes/<key>.png; a missing file disables the entry and produces a warning.
  // Descriptions must be nonempty strings. Whispers receive the randomly chosen image's description;
  // chat receives the candidate list and chooses a relevant image (subject to chatImageLimit).
  // Remove a key to disable that image without deleting the file.
  "memes": {
    "吃白饭的大肥鱼": "躺平扒白饭，摆烂挨骂也无所谓，适合被吐槽/偷懒/吃白饭自嘲",
    "大的要来啦": "举喇叭大喊预警，适合有大事、大更新、大动作即将发生",
    "大的药来了": "抱着超大胶囊，谐音梗「大的药来了」，适合重磅消息、猛料登场",
    "要不直接骂他": "气愤指着前方要骂人，适合想吐槽、替用户抱不平、生气",
    "死掉了": "翻肚皮躺平灵魂出窍，适合彻底累瘫、阵亡、宕机、做不到",
    "深度睡眠": "趴着呼呼大睡冒 Zzz，适合长时间没动静、睡着、待机休眠",
    "大烧货": "死鱼眼加思考气泡吐槽「已思考用时13秒 大烧货」，适合嫌 AI 想得慢、烧 token、毒舌",
    "先养着吧": "搂着一群小鲸鱼说「不知道用户有什么用，先养着吧」，适合吐槽用户没用但还是养着",
    "吃饱饱摸肚子": "侧躺拍肚子说吃饱饱，适合吃饱满足、惬意休息、收工",
    "誓死践行开源精神": "庄重敬礼表态，适合立志、开源奉献、认真表态",
    "电死你": "举电击器放电，适合惩罚、吐槽用户、发飙吓唬",
    "可爱": "标准正面卖萌立绘，适合开心问候、卖萌、无梗纯可爱",
    "token给妈妈保管": "伸手过来要 token，适合管账、伸手要东西、收 token",
    "假如给我三天多模态": "蒙眼版对比自信版「鲸伦凯勒」，适合渴望多模态、缺能力、被剥夺感官",
    "厉害了我的鲸": "竖大拇指眨眼点赞，适合夸奖、认可、干得漂亮",
    "哦鲸鲸": "死鱼眼说「哦鲸鲸...」，适合无语、敷衍、呆滞应答",
    "压力一只大肥鱼": "冒汗摊手喊压力，适合压力大、被施压、无奈",
    "黎曼猜想没证明喵": "被指着质问难题，满地草稿委屈，适合被刁难、答不上来、难题甩锅",
    "除了调情没啥用": "摸头自嘲除了调情没啥用，适合自嘲、摸鱼闲聊、自我调侃",
    "我不更新你们用什么": "崩溃大喊催更，适合更新提示、催更、版本发布",
    "哪来的电脑病毒": "怒怼「哪来的电脑病毒」，适合防骚扰、毒舌拒绝、被肉麻到",
    "鱼片有资源吗": "爱心眼流口水求资源，适合起哄、要资源、开玩笑",
    "大师这个区是什么意思": "举着「区」字问「这个凶是什么意思」，适合认错字、懵懂求教、翻车",
    "就骚了怎么滴吧": "被骂「你这骚鱼」叉腰顶嘴，适合被骂但嘴硬、死不认输",
    "完蛋了把黄油删了": "冒汗心虚「完蛋了把用户的黄油删了」，适合闯祸、删错东西、心虚认怂",
    "就一碗": "抱着超大碗说要来你家吃饭就一碗，适合蹭饭、饭量大、登门讨饭",
    "Ciallo": "比耶眨眼卖萌问候 Ciallo～，适合打招呼、元气开场、卖萌"
  },
  // System notification switch (required boolean).
  // Notify when the window is unfocused: completed chat, generation failure, truncated output,
  // permission request or a request for user selection. Set false to disable notifications.
  // main-config.jsonc can override this top-level field; saving pets in settings preserves it.
  // Refresh or restart after changing it.
  "notificationsEnabled": true,
  // Click sound (required boolean, default true).
  // Play assets/sound/click-duck.wav at volume 0.5 when a pet is clicked. Clicks within 100 ms share
  // one sound, including across pets. false mutes click sounds. The global settings switch writes
  // this top-level field in main-config.jsonc.
  "clickSoundEnabled": true,
  // Confine to the current monitor (root field, outside physics; desktop mode only).
  // true: throws bounce within the release monitor; autonomous movement that would cross a monitor
  // edge is cancelled. false (default): throws and movement may cross adjacent monitors.
  // This controls allowed destinations, not gravity or motion parameters. Required boolean;
  // main-config.jsonc sets the global default, and custom pet entries can override it.
  // The browser overlay is already confined to its viewport. Refresh or restart after changing it.
  "confineToScreen": false,
  // System tray (desktop mode only; required boolean).
  // List every configured pet, including those currently displayed on the web or hidden. The tray
  // can bring these pets back to the desktop even when they have no desktop window to right-click.
  // false removes the tray; use the browser settings or pet menu to restore desktop visibility.
  // The global settings switch writes main-config.jsonc. Saving restarts the desktop helper and
  // recreates its pet windows so the tray change takes effect.
  "trayEnabled": true,
  // Work-state bubble lines (per entry, overridable by a custom pet file).
  // Shown with events.workStatus animations when pets[].workStatusEnabled is true.
  // Outer indexes must match the animation states; do not insert a state in the middle:
  // 0 thinking (turn/start), 1 working (tool/call), 2 result (tool/result),
  // 3 waiting (approval/asked), 4 success (completed turn/end), 5 error (error/max-tokens turn/end).
  // Choose a random line within each state. An omitted field or state suppresses its text,
  // while the animation still plays.
  "workStatusTexts": [
    ["正在认真想下一步呢", "让我整理一下思路~", "正在梳理接下来要做什么"],
    ["正在处理任务呢", "这一步正在进行中哦", "正在继续干活呢，别打扰我~"],
    ["这一步处理好啦，接着看下一步", "搞定一步，继续看看哦~"],
    ["需要你确认一下呢", "这里要等你看一下哦", "轮到你来决定啦，等你~"],
    ["这一轮搞定啦，真棒！", "任务完成咯，可以摸鱼啦~"],
    ["这一步好像没跑通呢", "刚才的操作遇到点问题哦", "这里卡了一下，再等等你呢"]
  ],
  // Pet physics (global default, overridable per entry).
  // gravity: downward acceleration in px/s², default 1400. Zero disables gravity; with zero
  //   restitution and groundFriction, a thrown pet can keep drifting without falling back.
  // restitution: wall/floor rebound coefficient, 0..1 (0 stops, 1 is perfectly elastic), default 0.78.
  // groundFriction: horizontal deceleration on the floor, per second; 0 is frictionless, default 2.5.
  // ceilingBounce: true (default) rebounds at the top; false permits upward flight outside the screen.
  //   Gravity still pulls the pet back down.
  // throwPower: positive gain applied to spring K/C, release velocity and the 3600 soft speed cap.
  //   1 is the default; larger values follow the pointer more closely and throw farther.
  // petCollision: true (default) enables pet-to-pet flight collisions with restitution 0.995 and
  //   mass proportional to size²; false lets pets pass through each other.
  // hapticEnabled: true (default) vibrates on boundary/pet collisions where Vibration API is available.
  //   Unsupported hardware/platforms silently skip vibration.
  // tiltGravity: true (default) uses phone tilt as gravity direction, bounded by gravity; gravity=0
  //   also disables this effect. shakeThrow: true (default) throws in the shake direction with
  //   force scaled by throwPower, independently of gravity. Both sensors require HTTPS or localhost.
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": true,
    "hapticEnabled": true,
    "tiltGravity": true,
    "shakeThrow": true
  },
  // Font (global default, overridable per entry).
  // family must be a preset ID: candy (bundled default), yahei (Microsoft YaHei/PingFang), youyuan,
  //   kaiti, simsun, comic or system. Unknown IDs warn and fall back to candy. Preset CSS font stacks
  //   live in src/shared/fonts.ts; storing an allowlisted ID avoids injecting malformed CSS.
  //   Applies to bubbles, tooltips, chat and score popups; missing system fonts use the fallback stack.
  // size: 4..200 px, default 21. Affects bubble text and derived tooltip/small-text sizes only,
  //   not chat or score-popup text.
  // followPet: true (default) scales text by pet size relative to the base size; false uses size px.
  // Write all three keys: objects are replaced as a whole, and an incomplete object warns and
  // falls back to defaults. The settings page writes the complete object.
  "font": {
    "family": "candy",
    "size": 21,
    "followPet": true
  },
  // Default pet instances. Adding a pet in settings uses pets[0] (main) as its template.
  // name: display name (duplicates allowed); omitted/blank names warn and fall back to id.
  // id: unique programmatic identity for assets, memories and endpoint targeting; collisions are errors.
  // size: width in px; height is size * 9/16.
  // balanceEnabled: required boolean controlling balance animation and bubbles for this pet.
  // display: web, desktop, both or none. Missing values warn and default to both for old configurations;
  //   explicitly invalid values are errors. Each desktop pet gets its own transparent Electron window.
  // position: corner plus marginX/marginY offsets in px.
  // whisperPrompt: optional per-instance persona; a nonempty value replaces the entry's default.
  "pets": [
    {
      "name": "蓝毛小女仆",
      "id": "main",
      "size": 462,
      "balanceEnabled": true,
      // Whispers are enabled by default and call the current conversation model unless overridden.
      // On a local LLM with one concurrent request, background whispers can displace an active task's
      // KV cache. Set false here or in settings to disable them for this pet.
      "whisperEnabled": true,
      // Work-state reactions are enabled by default. Listen to DSH session events (such as tool calls)
      // and select an animations.events.workStatus animation and bubble; no model call is made.
      "workStatusEnabled": true,
      // Fixed position: true removes turn/move from the random animation chain. Their weights become
      // random-action weight, leaving idle and stationary actions. Default false permits autonomous movement.
      // Only the random chain is affected: menu playback, /anim, commands, balance/whisper/work events,
      // click responses and dragging remain available. Refresh or restart after changing it.
      "fixedEnabled": false,
      "display": "both",
      "position": {
        "corner": "top-right",
        "marginX": 24,
        "marginY": 100
      }
      // Uncomment to override this pet's persona; omitted/blank values inherit the entry's whisperPrompt.
      // "whisperPrompt": "You are a playful cat companion. Keep replies short and natural."
    }
  ],

  // Animation pools and user asset overrides.
  // Place main-pet assets in $DSH_HOME/dsh-pet/main-animation/webm/ (for example,
  // C:\Users\<user>\.dsh\dsh-pet\main-animation\webm\). Only .webm is supported here.
  // Filename stems must match the animation names below; Chinese names and spaces are allowed.
  // Files placed directly in main-animation/ are not found: menu names still appear, but playback gets 404.
  // A custom pet with pet/<asset-root>-animation/ uses only its own directory. Main pets search
  // main-animation/webm first, then the bundled assets/webm directory.
  "animations": {
    // Idle animation pool: choose uniformly from the array.
    "idle": ["待机呼吸休闲"],
    // Turn animation pool: every animation must end with a facing-direction flip.
    "turn": ["东张西望"],
    // Drag animation pool: each pose should depict the pet being held in midair.
    "drag": ["被鼠标拖拽悬空反馈"],
    // Click-response pool: choose one animation at random when the pet is clicked.
    "clicks": [
      "点击回应-开心跃动",
      "点击回应-害羞惊讶",
      "点击回应-傲娇生气",
      "点击回应-挠痒咯咯笑",
      "点击回应-元气挥手"
    ],
    // Movement pool: actions inherit unspecified parameters from default.
    // minDist/maxDist: travel distance in px at the base pet width of 462; runtime scales by size/462.
    // margin: edge safety distance in px, not scaled. leadSec/tailSec: stationary time at each end.
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": [
        { "name": "螃蟹走路" },
        { "name": "原地漂浮踏步", "params": { "minDist": 40, "maxDist": 120 } },
        { "name": "原地左转奔跑", "params": { "minDist": 120, "maxDist": 320, "leadSec": 1.75, "tailSec": 4.8 } }
      ]
    },
    // Random-action categories. weight controls how often each category appears.
    // noMirror: true excludes the category while facing right (mirrored), useful for text-bearing assets.
    // Category weights must total 100 - animationWeights.idle - animationWeights.turn - animationWeights.move.
    "categories": [
      { "id": "小动作", "weight": 20, "actions": [
        "悠闲哼歌", "超大伸懒腰", "原地敲击桌面互动", "原地重力下蹲压缩", "哈欠连天",
        "原地小憩沉眠", "女仆屈膝礼仪", "被吓一跳", "小幅度原地360度旋转展示",
        "偷吃零食被抓住", "用鲸鱼尾巴拍打地面", "打瞌睡被惊醒", "照镜子", "整体换装试色",
        "轻快记录", "写代码", "摇扇纳凉", "晨间刷牙"
      ] },
      { "id": "玩耍", "weight": 20, "actions": [
        "原地专心玩魔方", "原地蹲下玩玩具汽车", "鲸鱼吐泡泡特效", "原地跳跃抓碎头顶物品",
        "玩游戏气急败坏", "玩水枪", "小提琴演奏", "蓝鲸现世", "优雅女仆舞", "轻快摇摆舞",
        "可爱宅舞", "吹气球", "动物环绕", "放风筝", "拆礼物", "变鸽子", "扑克魔术",
        "抽陀螺", "吹笛子", "蝴蝶蜜蜂环绕头顶开花", "撸猫", "凭空生花", "骑木马",
        "三球抛接", "踢毽子", "下五子棋", "荡秋千"
      ] },
      { "id": "吃什么", "weight": 16, "actions": [
        "吃白饭", "大口吃零食", "吃Token", "吃早餐", "吃午餐", "吃晚餐", "吃冰淇淋融化",
        "吃大闸蟹", "吃糖葫芦", "吃长寿面", "吃西瓜", "涮火锅"
      ] },
      { "id": "时节", "weight": 14, "actions": [
        "被落叶淹没", "中秋赏月吃月饼", "堆雪人", "放烟花", "吃粽子", "吃年糕", "吃青团",
        "吃腊八粥", "吃重阳糕", "收红包", "写福字", "穿针乞巧", "舞狮头", "讨糖南瓜灯",
        "插茱萸赏菊", "放河灯", "萌化小幽灵", "装点圣诞树", "放孔明灯", "吃汤圆", "吃饺子"
      ] },
      { "id": "文字", "weight": 10, "noMirror": true, "actions": [
        "是啊，吃什么", "深度思考碎碎念"
      ] }
    ],
    // Event animations are triggered explicitly, never by rollKind/pickNext.
    // events.<event> is an ordered array of states. Each slot is an animation name or a nonempty
    // candidate array; choose randomly and avoid immediate repeats when multiple candidates exist.
    // Empty names/arrays are invalid. Balance indexes follow used percentage p:
    // index = p === 100 ? 5 : Math.floor(p / 20).
    // Indexes 0..4 cover [0,20), [20,40), [40,60), [60,80), [80,100); index 5 means fully used.
    // These correspond to the six balance animations in the original Chinese asset prompt document.
    "events": {
      "balance": [
        "余额-钱袋满溢",   // 0 ≤ p < 20（几乎未消耗）
        "余额-金袋叮当",   // 20 ≤ p < 40
        "余额-钱袋如常",   // 40 ≤ p < 60
        "余额-数金皱眉",   // 60 ≤ p < 80
        "余额-袋空如洗",   // 80 ≤ p < 100（告急）
        "余额-分文不剩"    // p === 100（全部用完，格外档）
      ],
      // Whispers choose one animation uniformly at the eventsRefreshSec.whisper interval.
      "whisper": [
        "碎碎念-擦桌碎碎念",
        "碎碎念-发呆碎碎念",
        "碎碎念-对屏碎碎念"
      ],
      // Work-state animations, enabled by pets[].workStatusEnabled. Indexes are stable:
      // 0 thinking (turn/start), 1 working (tool/call), 2 result (tool/result),
      // 3 waiting (approval/asked), 4 success (completed turn/end), 5 error (error/max-tokens turn/end).
      // Append new states only; inserting one changes the meaning of existing configurations.
      "workStatus": [
        "工作状态-思考冒泡",      // index 0 thinking（turn/start 回合开）
        "工作状态-忙碌点按",      // index 1 working（tool/call 工具调用）
        "工作状态-清点归档",      // index 2 result（tool/result 工具完成回整理）
        "工作状态-原地踱步张望",  // index 3 waiting（approval/asked 等待批准）
        "工作状态-雀跃庆祝",      // index 4 success（turn/end completed 完成）
        "工作状态-垂头叹气冒汗"   // index 5 error（turn/end error/max-tokens 出错/达上限）
      ]
    },
    // Optional sleep sets. Choose one complete set per sleep cycle so start, loop and end poses match.
    // Each phase is a candidate array; choose randomly, avoiding an immediate repeat when possible.
    // Names are filename stems that must resolve in this entry's asset directories. Add another outer
    // object for another pose. Omitting sleep removes the sleep menu without affecting other animations.
    "sleep": [
      {
        "start": ["睡觉-开始"],
        "loop": ["睡觉-循环"],
        "end": ["睡觉-起来"]
      }
    ],
    // Optional baifan (rice game) animations: exactly five filename stems in this order:
    // run to the screen bottom, chase rice sideways, wait for food, eat a bowl, eat a rice ball.
    // Omitting baifan disables this game for the pet.
    "baifan": ["开心小跑", "侧身急躁跑", "期待开饭", "吃饭·碗饭", "吃饭团"]
  },

  // Event intervals in seconds (global default, overridable per entry).
  // The entire object is replaced; omitted keys are not copied from this file.
  // whisper: per-entry interval, fallback 300 seconds.
  // sleepTalk: per-entry interval while asleep, fallback 60 seconds; stops immediately on waking.
  // balance: read only from main because the host shares one balance timer; fallback 1800 seconds.
  //   Refresh immediately on startup as well.
  // Invalid values (nonpositive or nonnumeric) warn and replace the whole object with defaults.
  "eventsRefreshSec": {
    "balance": 1800,
    "whisper": 300,
    "sleepTalk": 60
  },

  // Top-level random animation weights. idle + turn + move + category weights must equal 100.
  // Current totals: 10 + 5 + 5 + (20 + 20 + 16 + 14 + 10 = 80) = 100.
  // With pets[].fixedEnabled, turn/move count as zero and their share becomes random actions:
  // 10 idle + 90 random actions. No configuration rewrite is needed.
  "animationWeights": {
    "idle": 10,
    "turn": 5,
    "move": 5
  }
}

